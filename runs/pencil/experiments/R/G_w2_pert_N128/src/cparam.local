!                       -*-f90-*-    (for Emacs)
!  cparam.local
!
!  Local settings concerning grid size and number of CPUs.
!  This file is included by cparam.f90
!
!  1 chunk for divE_as_aux
!
! MAUX CONTRIBUTION 1
!  1 MVAR for the rhoe slot (holds J0 with lsolve_J0)
! MVAR CONTRIBUTION 1
! COMMUNICATED AUXILIARIES 0
!
integer, parameter :: ncpus=8,nprocx=1,nprocz=4,nprocy=ncpus/(nprocx*nprocz)
integer, parameter :: nxgrid=128,nygrid=nxgrid,nzgrid=nxgrid
